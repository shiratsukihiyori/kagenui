				margin: 0;
				padding: 20px;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				text-align: center;
			}
			img {
				max-width: 200px;
				height: auto;
				margin: 20px 0;
				object-fit: contain;
			}
			#spinner {
				border: 4px solid rgba(0, 0, 0, 0.1);
				width: 36px;
			height: 36px;
			border-radius: 50%;
			border-left-color: #09f;
			animation: spin 1s linear infinite;
			margin: 20px auto;
		}
		@keyframes spin {
			0% { transform: rotate(0deg); }
			100% { transform: rotate(360deg); }
		}
