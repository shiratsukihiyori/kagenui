<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>kagenui</AssemblyName>
    <RootNamespace>Kagenui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <InformationalVersion>1.0.4</InformationalVersion>
    <AssemblyTitle>Kagenui</AssemblyTitle>
    <Product>Kagenui</Product>
    <Company>白月日和</Company>
    <Description>把指定进程的 TCP/UDP 流量转发进系统代理</Description>
    <Copyright>© 2026 白月日和</Copyright>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="engine\WinDivert.dll" LogicalName="engine.WinDivert.dll" />
    <EmbeddedResource Include="engine\WinDivert64.sys" LogicalName="engine.WinDivert64.sys" />
  </ItemGroup>
</Project>
